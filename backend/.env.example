# ============================================================
# Energent Backend Configuration
# ============================================================

# -----------------------------
# Application
# -----------------------------
APP_NAME=Energent
APP_VERSION=0.1.0

DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# -----------------------------
# EnergyPlus
# -----------------------------

# Path to the EnergyPlus executable
# Windows: C:/EnergyPlusV26-1-0/energyplus.exe
# WSL: /mnt/c/EnergyPlusV26-1-0/energyplus.exe
ENERGYPLUS_EXE_PATH=/mnt/c/EnergyPlusV26-1-0/energyplus.exe

# Project simulation files (relative to backend directory)
ENERGYPLUS_IDF_PATH=../simulation/idf/RefBldgSmallOfficeNew2004_Chicago.idf
ENERGYPLUS_WEATHER_PATH=../simulation/weather/USA_IL_Chicago-OHare.Intl.AP.725300_TMY3.epw
ENERGYPLUS_OUTPUT_DIR=../simulation/output
ENERGYPLUS_TIMEOUT=600

# -----------------------------
# LLM Configuration
# -----------------------------

OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_MODEL=qwen/qwen3-8b
LLM_TIMEOUT=60
